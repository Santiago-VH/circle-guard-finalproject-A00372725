# Copia de referencia. El script bootstrap-ci.sh crea infra/.env y pide/genera
# los valores que falten.

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_LOCATION_URL=http://localhost:8080/

# GitHub (PAT classic con scopes: repo, admin:repo_hook)
GITHUB_USER=
GITHUB_TOKEN=

# SonarQube
SONAR_ADMIN_PASSWORD=
SONAR_DB_PASSWORD=
SONAR_TOKEN=
